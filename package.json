{
  "name": "handsfree-for-chrome",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "Voice control for Chrome with local command interpretation.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/watch.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build && node scripts/verify-build.mjs",
    "package": "node scripts/package.mjs",
    "models:download": "node scripts/download-model.mjs",
    "eval:model": "node scripts/smoke-model.mjs",
    "build:local-ai": "tsc --noEmit && node scripts/build.mjs --local-ai",
    "package:local-ai": "node scripts/package.mjs --local-ai",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:upgrade": "playwright test --config=playwright.upgrade.config.ts",
    "check:local-ai": "npm run build:local-ai && node scripts/verify-build.mjs --local-ai"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.313",
    "@types/node": "^22.13.10",
    "@webgpu/types": "^0.1.60",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "happy-dom": "^20.14.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
